    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json.body;\n\n// Normalize incoming field names\nconst normalizedData = {\n  name: data.name,\n  email: data.email,\n  company_name: data.company_name ?? data.companyName,\n  interested_service:\n    data.interested_service ?? data.interestedService,\n  message: data.message\n};\n\n// Required fields\nconst requiredFields = [\n  'name',\n  'email',\n  'company_name',\n  'interested_service',\n  'message'\n];\n\n// Validate required fields\nfor (const field of requiredFields) {\n  if (\n    normalizedData[field] === undefined ||\n    normalizedData[field] === null ||\n    !String(normalizedData[field]).trim()\n  ) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\n// Validate and normalize email\nconst email = String(normalizedData.email)\n  .trim()\n  .toLowerCase();\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  throw new Error('Invalid email address');\n}\n\n// Bangladesh local timestamp\nconst submissionDate = new Date().toLocaleString(\n  'sv-SE',\n  { timeZone: 'Asia/Dhaka' }\n);\n\n// Generate unique Lead ID\nconst leadId = `LD-${Date.now()}-${Math.floor(Math.random() * 10000)}`;\n\n// Return normalized lead data\nreturn [{\n  json: {\n    Lead_ID: leadId,\n    Name: String(normalizedData.name).trim(),\n    Email: email,\n    Company_Name: String(normalizedData.company_name).trim(),\n    Interested_Service: String(normalizedData.interested_service).trim(),\n    Message: String(normalizedData.message).trim(),\n    Submission_Date: submissionDate,\n    Email_Status: 'Pending',\n    Email_Sent_At: ''\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -112
      ],
      "name": "Code in JavaScript"
